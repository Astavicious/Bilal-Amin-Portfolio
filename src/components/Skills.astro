---
import Section from "./Section.astro";
import type { SkillGroupProps } from "@types";

interface Props {
  skills: SkillGroupProps[];
}

const { skills } = Astro.props;
---

<Section text="Skills & Coursework" href="skills">
  <div class="grid gap-5 md:grid-cols-2">
    {
      skills.map(({ category, items }) => (
        <article class="rounded-2xl border border-neutral/20 bg-[#1c232d] p-6">
          <h3 class="mb-5 font-serif text-2xl font-semibold text-primary">
            {category}
          </h3>
          <ul class="flex flex-wrap gap-2">
            {items.map((item) => (
              <li class="rounded-full border border-white/10 bg-black/30 px-3 py-2 text-xs text-white/90">
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
