---
import type { HeroProps } from "@types";
type Props = HeroProps;

const { name, specialty, summary, email, phone, location, resumeUrl } = Astro.props;
---

<section class="py-24 md:py-32" id="hero">
  {location && (
    <p class="mb-5 text-xs font-medium tracking-[0.2em] text-neutral uppercase">
      {location}
    </p>
  )}
  <h1
    class="mb-1.5 font-serif text-7xl font-bold tracking-tightest text-white sm:text-8xl md:mb-0 md:text-9xl"
  >
    {name}
  </h1>
  <p
    class="mb-9 font-serif text-4xl leading-[46px] font-bold tracking-tighter text-primary sm:text-5xl md:text-6xl"
  >
    {specialty}
  </p>
  <p class="mb-12 max-w-2xl text-base font-normal text-neutral md:text-lg">
    {summary}
  </p>

  <div class="flex flex-wrap gap-4">
    <a
      class="inline-block rounded-full bg-primary px-7 py-4 text-sm leading-5 font-medium text-white transition-transform hover:-translate-y-0.5"
      href={`mailto:${email}`}>Email Me</a
    >
    {resumeUrl && (
      <a
        class="inline-block rounded-full border border-white/20 bg-white/5 px-7 py-4 text-sm leading-5 font-medium text-white transition-colors hover:bg-white/10"
        href={resumeUrl}
        target="_blank"
      >
        View CV
      </a>
    )}
    {
      phone && (
        <a
          class="inline-block rounded-full border border-white/20 bg-white/5 px-7 py-4 text-sm leading-5 font-medium text-white transition-colors hover:bg-white/10"
          href={`tel:${phone.replace(/\s+/g, "")}`}
        >
          Call Me
        </a>
      )
    }
    <a
      class="inline-block rounded-full border border-white/20 bg-white/5 px-7 py-4 text-sm leading-5 font-medium text-white transition-colors hover:bg-white/10"
      href="#projects"
    >
      View Projects
    </a>
  </div>
</section>
